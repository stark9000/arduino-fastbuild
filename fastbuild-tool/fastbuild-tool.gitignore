arduino-cli.yaml

# Your own real, working fastbuild config (contains your actual sketch
# paths, cache root, etc.) - keep fastbuild.config.example checked in
# instead, as a generic, safe-to-share template.
fastbuild.config

# Compiled binary
fastbuild.exe

# Go build/test artifacts
*.test
*.out
